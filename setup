#!/bin/bash
# Bootstrap: install mise, then chezmoi via mise, then apply this repo in place.
set -euo pipefail

SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

MISE="$(command -v mise || true)"
[ -n "$MISE" ] || MISE="$HOME/.local/bin/mise"
[ -x "$MISE" ] || { curl -fsSL https://mise.run | sh; MISE="$HOME/.local/bin/mise"; }

# one-off chezmoi; the repo's mise config installs it permanently
"$MISE" x chezmoi@latest -- chezmoi init --source "$SRC" --apply
